{
  "name": "wodblok",
  "private": true,
  "version": "2.27.0",
  "description": "WODBLOK stamped-pattern editor (web app first). Phase 0: safety net around the v100 baseline.",
  "scripts": {
    "build": "node tools/build.js",
    "templates": "node tools/templates/make.js",
    "build:single": "node tools/build.js",
    "build:web": "node tools/build.js --web",
    "dev": "node tools/serve-esm.js",
    "test": "playwright test --project=chromium",
    "test:update-golden": "playwright test --project=chromium --update-snapshots",
    "test:webkit": "playwright test --project=webkit --grep @smoke",
    "perf-baseline": "WB_PERF=1 playwright test --project=chromium tests/perf-baseline.spec.js",
    "perf": "node tools/perf.js",
    "typecheck": "tsc -p .",
    "check:platform": "node tools/check-platform.js",
    "check:style": "node tools/check-style.js",
    "coupling-map": "node tools/coupling-map.js dist/wodblok.html > docs/coupling-map.md",
    "test:build": "node tools/build.js && playwright test --project=chromium",
    "test:site": "node --disable-warning=ExperimentalWarning --test tests/site-waitlist.test.mjs tests/site-accounts.test.mjs tests/site-accent.test.mjs",
    "social": "node tools/social/run.js"
  },
  "devDependencies": {
    "@playwright/test": "1.56.0",
    "eslint-scope": "9.1.2",
    "espree": "11.2.0",
    "typescript": "^7.0.2"
  },
  "dependencies": {
    "fflate": "^0.8.3"
  }
}

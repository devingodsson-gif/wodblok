{
  "name": "wodblok",
  "private": true,
  "version": "1.9.1",
  "description": "WODBLOK stamped-pattern editor (web app first). Phase 0: safety net around the v100 baseline.",
  "scripts": {
    "build": "node tools/build.js",
    "build:single": "node tools/build.js",
    "build:web": "node tools/build.js --web",
    "dev": "node tools/serve-esm.js",
    "test": "playwright test --project=chromium",
    "test:legacy": "WB_TARGET=legacy playwright test --project=chromium",
    "test:update-golden": "playwright test --project=chromium --update-snapshots",
    "test:webkit": "playwright test --project=webkit --grep @smoke",
    "perf-baseline": "WB_PERF=1 playwright test --project=chromium tests/perf-baseline.spec.js",
    "perf": "WB_PERF=1 playwright test --project=chromium tests/perf.spec.js",
    "typecheck": "tsc -p .",
    "check:platform": "node tools/check-platform.js",
    "coupling-map": "node tools/coupling-map.js legacy/wodblok-v100.html > docs/coupling-map.md",
    "test:build": "node tools/build.js && WB_TARGET=build playwright test --project=chromium",
    "test:site": "node --test tests/site-waitlist.test.mjs"
  },
  "devDependencies": {
    "@playwright/test": "1.56.0",
    "eslint-scope": "9.1.2",
    "espree": "11.2.0",
    "typescript": "^7.0.2"
  },
  "dependencies": {
    "fflate": "^0.8.3"
  }
}
